# Adhya local development configuration
# Copy to .env locally. Never commit real credentials.

APP_ENV=local
APP_DEBUG=false
APP_PORT=8080

# PostgreSQL Clinical Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adhya
POSTGRES_USER=adhya
POSTGRES_PASSWORD=change-me

# Siddhi Stream Processor (CEP)
SIDDHI_HTTP_PORT=8006
SIDDHI_MGMT_PORT=9091

# WSO2 API Manager 4.3.0
WSO2_APIM_CONSOLE_PORT=9443
WSO2_APIM_GATEWAY_HTTPS=8243
WSO2_APIM_GATEWAY_HTTP=8280

# WSO2 Identity Server 7.0.0 (IAM)
WSO2_IS_PORT=9444

# WSO2 FHIR / Micro Integrator 4.3.0
WSO2_FHIR_HTTP_PORT=8290
WSO2_FHIR_HTTPS_PORT=8253
WSO2_MI_MGMT_PORT=9164

# Dedicated HAPI FHIR Database (F12 Interoperability Layer)
POSTGRES_FHIR_DB=adhya_fhir
POSTGRES_FHIR_USER=adhya_fhir
POSTGRES_FHIR_PASSWORD=change-me

# HAPI FHIR R4 Server
FHIR_SERVER_PORT=8080

# OpenChoreo / Choreo Connect Router
OPENCHOREO_ROUTER_PORT=9095

API_BASE_URL=http://localhost:8080
